# Copia este archivo como .env (o define las variables en tu servicio de hosting).

# Puerto del servidor
PORT=3000

# Carpeta donde se guardan la base de datos, las fotos y las claves de notificaciones.
# Debe ser un disco persistente y privado.
DATA_DIR=./data

# Cookies solo por HTTPS (true por defecto con NODE_ENV=production)
COOKIE_SECURE=true

# Si la app está detrás de un proxy o balanceador (Render, Railway, Fly, Nginx…)
TRUST_PROXY=1

# Botón «Probar con datos de demostración». Recomendado: false cuando ya la uses de verdad.
DEMO_ENABLED=true

# Permitir crear cuentas nuevas. Recomendado: false después de crear tu cuenta.
ALLOW_REGISTRATION=true

# Duración de la sesión iniciada (días)
SESSION_DAYS=180

# Notificaciones push (recordatorios). Las claves se generan solas en DATA_DIR si no se indican.
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
